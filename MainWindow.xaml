<Window x:Class="FactorialApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:FactorialApp.Models"
        Title="Industrial Machine Vision HMI"
        Width="1500" Height="900" MinWidth="1200" MinHeight="720"
        Background="#06111E" Foreground="#F3F8FC"
        FontFamily="Segoe UI Variable Text"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#071827" Offset="0"/>
            <GradientStop Color="#081522" Offset="0.48"/>
            <GradientStop Color="#050D18" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B51A2D40" Offset="0"/>
            <GradientStop Color="#8A102335" Offset="0.55"/>
            <GradientStop Color="#75101C2B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.35"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassBorder" Color="#55B6D5E8"/>
        <SolidColorBrush x:Key="Muted" Color="#9DB2C3"/>
        <SolidColorBrush x:Key="Cyan" Color="#2AD7FF"/>
        <SolidColorBrush x:Key="Green" Color="#29E6A1"/>
        <SolidColorBrush x:Key="Red" Color="#FF6475"/>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.22"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAF6FF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,7,0,3"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA7BA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#6B081726"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4D7C9BB1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,5"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#A60B789A"/>
            <Setter Property="BorderBrush" Value="#7748D8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border CornerRadius="14" Background="{StaticResource GlassHighlight}" Opacity="0.5"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#56071624"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#350A1A28"/>
            <Setter Property="AlternatingRowBackground" Value="#4A102434"/>
            <Setter Property="BorderBrush" Value="#466A879C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#284E6B80"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="40"/>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9DB4C7"/><Setter Property="Padding" Value="20,9"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="122"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- floating glass header -->
        <Border Grid.Row="0" Margin="18,12,18,6" CornerRadius="24" BorderBrush="#557C9DB4" BorderThickness="1" Background="#A30B1D2C">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="13" Background="#8C0B607B" BorderBrush="#5F43D9FF" BorderThickness="1" Margin="0,0,13,0">
                        <TextBlock Text="◇" Foreground="{StaticResource Cyan}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Industrial Vision" FontSize="19" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding MachineState}" Foreground="{StaticResource Green}" FontSize="11"/>
                            <TextBlock Text="  ·  " Foreground="#6E8A9E"/>
                            <TextBlock Text="{Binding StateDetail}" Foreground="#A8BCCB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#50152A3B" BorderBrush="#446D8A9E" BorderThickness="1" CornerRadius="16" Padding="13,8" Margin="0,0,7,0">
                        <TextBlock Text="{Binding UserText}" Foreground="#D6E5EF" FontSize="11"/>
                    </Border>
                    <Button Content="LOGOUT" Command="{Binding LogoutCommand}" MinWidth="92"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,4,18,6" Foreground="White">
            <TabItem Header="MONITOR">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource GlassCard}" Padding="17" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="DEVICE HEALTH" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,9,0"/><TextBlock Text="Camera" Foreground="#BBD0DF"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CameraText}" Foreground="{StaticResource Green}" FontSize="11"/></Grid>
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,9,0"/><TextBlock Text="PLC" Foreground="#BBD0DF"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PlcText}" Foreground="{StaticResource Green}" FontSize="11"/></Grid>
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,9,0"/><TextBlock Text="Vision" Foreground="#BBD0DF"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding VisionText}" Foreground="{StaticResource Green}" FontSize="11"/></Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="17" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVE RECIPE" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Name"/>
                                <TextBlock Text="Product" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.ProductCode}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="VERSION" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedRecipe.Version}" FontSize="19" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="GAIN" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedRecipe.Gain}" FontSize="19" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Exposure (μs)" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.ExposureUs}"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="RUN ONE PLC CYCLE" Command="{Binding RunCycleCommand}" Height="46" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="AUTO START" Command="{Binding AutoStartCommand}" Height="42"/><Button Grid.Column="1" Content="AUTO STOP" Command="{Binding AutoStopCommand}" Height="42" Background="#58313A4D" BorderBrush="#4CFF7180"/></Grid>
                        </Grid>
                    </Grid>

                    <!-- CENTER -->
                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource GlassCard}" Padding="20,12" Margin="0,0,0,10">
                            <UniformGrid Columns="4">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="TOTAL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Total}" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PASS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Pass}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Green}" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="NG" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Ng}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Red}" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="YIELD" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Yield, Mode=OneWay, StringFormat={}{0:F1}%}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,3,0,0"/></StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
                                <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LIVE INSPECTION" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#5B153248" CornerRadius="13" Padding="11,5"><TextBlock Text="LIVE RESULT" Foreground="#91AABC" FontSize="10"/></Border></Grid>

                                <Border Grid.Row="1" Margin="4,0,4,10" CornerRadius="18" BorderBrush="#455E839B" BorderThickness="1" Background="#B7030A11" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding LastInspectionImage}" Stretch="Uniform" Margin="10"/>
                                        <TextBlock Text="WAITING FOR INSPECTION" Foreground="#526E82" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#B80A1B29" BorderBrush="#3F8AAAC0" BorderThickness="1" CornerRadius="13" Padding="11,6">
                                            <TextBlock Text="{Binding LastResultText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="4,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="RESULT / SERIAL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LastResultText}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/><TextBlock Text="{Binding LastInspection.SerialNumber}" Foreground="#8FA8BA" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="X" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LastInspection.X, StringFormat={}{0:F2}}" FontSize="18"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Y" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LastInspection.Y, StringFormat={}{0:F2}}" FontSize="18"/></StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="ANGLE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LastInspection.Angle, StringFormat={}{0:F2}°}" FontSize="18"/></StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="AREA" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding LastInspection.Area, StringFormat={}{0:F0}}" FontSize="18"/></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT -->
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource GlassCard}" Padding="17" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VISION LIMITS" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Threshold Mode" Style="{StaticResource Label}"/><ComboBox Text="{Binding SelectedRecipe.ThresholdMode}" IsEditable="True"/>
                                <TextBlock Text="Threshold" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.Threshold}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Min Area" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.MinArea}"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Max Area" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.MaxArea}"/></StackPanel></Grid>
                                <TextBlock Text="Position Tolerance" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.PositionTolerance}"/>
                                <TextBlock Text="Angle Tolerance" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.AngleTolerance}"/>
                                <TextBlock Text="Area Tolerance %" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.AreaTolerancePercent}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="17">
                            <StackPanel><TextBlock Text="SYSTEM" Style="{StaticResource SectionTitle}"/><TextBlock Text="PLC handshake  ·  camera  ·  vision" Foreground="#AFC3D2" FontSize="11"/><TextBlock Text="Traceability  ·  RBAC  ·  watchdog" Foreground="#819DB1" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="SQLite inspection archive" Foreground="#819DB1" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="HISTORY">
                <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0" Padding="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel Margin="4,0,4,10"><TextBlock Text="From" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><DatePicker SelectedDate="{Binding FilterFrom}" Margin="6,0,12,0"/><TextBlock Text="To" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><DatePicker SelectedDate="{Binding FilterTo}" Margin="6,0,12,0"/><TextBox Width="125" Text="{Binding FilterProduct}" ToolTip="Product"/><TextBox Width="125" Text="{Binding FilterRecipe}" ToolTip="Recipe"/><ComboBox Width="95" ItemsSource="{Binding ResultFilters}" SelectedItem="{Binding FilterResult}"/><TextBox Width="95" Text="{Binding FilterNgCode}" ToolTip="NG Code"/><TextBox Width="175" Text="{Binding FilterSerial}" ToolTip="Serial number"/><Button Content="SEARCH" Command="{Binding RefreshHistoryCommand}"/><Button Content="EXPORT CSV" Command="{Binding ExportCsvCommand}"/></WrapPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding InspectionHistory}" AlternationCount="2"><DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"/><DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="190"/><DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductCode}" Width="105"/><DataGridTextColumn Header="RECIPE" Binding="{Binding RecipeName}" Width="105"/><DataGridTextColumn Header="VER" Binding="{Binding RecipeVersion}" Width="48"/><DataGridTextColumn Header="PASS" Binding="{Binding Passed}" Width="55"/><DataGridTextColumn Header="NG CODE" Binding="{Binding NgCode}" Width="75"/><DataGridTextColumn Header="NG REASON" Binding="{Binding NgReason}" Width="*"/><DataGridTextColumn Header="OPERATOR" Binding="{Binding Operator}" Width="95"/>
                            <DataGridTemplateColumn Header="IMAGE" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="VIEW" Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns></DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="RECIPES" Visibility="{Binding IsEngineer, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Name" Background="#35081825" Foreground="White" BorderBrush="#456B879B"/><StackPanel Grid.Column="1" Width="450" HorizontalAlignment="Left" Margin="22,0,0,0"><TextBlock Text="Recipe name" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.Name}"/><TextBlock Text="Product code" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedRecipe.ProductCode}"/><TextBlock Text="Current version" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedRecipe.Version}" FontSize="20"/><Button Content="NEW RECIPE" Command="{Binding NewRecipeCommand}"/><Button Content="SAVE AS NEW VERSION" Command="{Binding SaveRecipeCommand}"/></StackPanel></Grid></Border>
            </TabItem>

            <TabItem Header="ALARMS">
                <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="REFRESH" Command="{Binding RefreshAlarmsCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/><DataGrid Grid.Row="1" ItemsSource="{Binding AlarmHistory}"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding Timestamp}" Width="160"/><DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="80"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/><DataGridCheckBoxColumn Header="ACK" Binding="{Binding IsAcknowledged}" Width="60"/><DataGridTemplateColumn Header="ACTION" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="ACK" Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="18,0,18,8" Padding="14,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SYSTEM LOG" Style="{StaticResource MetricLabel}"/><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#BDD1DF" FontFamily="Consolas" FontSize="11"/></Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="Industrial HMI  ·  PLC handshake  ·  camera  ·  vision  ·  traceability  ·  RBAC  ·  watchdog" Margin="22,0" VerticalAlignment="Center" Foreground="#527087" FontSize="10"/>

        <!-- Login is handled by the full-screen overlay. No duplicate LOGIN button in the header. -->
        <Border x:Name="LoginOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="999" Background="#C7040C14">
            <Border Width="430" Padding="28" Background="#E00D2030" BorderBrush="#668FD6F5" BorderThickness="1" CornerRadius="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.4"/></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="18" Background="#7A0B789A" BorderBrush="#694CE1FF" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="◇" FontSize="27" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Industrial Vision" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Operator authentication" Foreground="#8FA8BA" Margin="0,4,0,18"/>
                    <TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox x:Name="UsernameBox" Text="operator"/>
                    <TextBlock Text="Password" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordBox" Password="Operator123!" Margin="0,2,0,5" Padding="10,8" Background="#6B081726" Foreground="White" BorderBrush="#4D7C9BB1"/>
                    <TextBlock x:Name="LoginError" Foreground="{StaticResource Red}" Margin="0,5"/>
                    <Button Content="LOGIN" Height="46" Click="Login_Click" Margin="0,12,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
